{
  "info": {
    "_postman_id": "vex-api-collection-v2",
    "name": "V-EX - Admin & Statistik API",
    "description": "Koleksi endpoint untuk Admin V-EX: Manajemen Pameran, Pencatatan Kunjungan 3D, dan Visualisasi Statistik Pengunjung.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth - Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('admin_token', jsonData.token);",
              "    console.log('Token otomatis tersimpan ke variabel collection: ' + jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@pbl.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login sebagai Admin untuk mendapatkan token. Script test akan otomatis menyimpan token ke variabel collection `admin_token`."
      }
    },
    {
      "name": "2. Admin - Tambah Pameran",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "kategori_kode",
              "value": "IOT",
              "type": "text",
              "description": "Wajib (Pilihan: IOT, WEB, ANV, JCS, OTO, RAI, TTG, PRF, PDF, KDS, LJU, KTI)"
            },
            {
              "key": "title",
              "value": "Pameran Inovasi Teknologi 2026",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Pameran karya inovasi mahasiswa semester genap.",
              "type": "text"
            },
            {
              "key": "prepare_start",
              "value": "2026-09-01",
              "type": "text"
            },
            {
              "key": "prepare_end",
              "value": "2026-09-10",
              "type": "text"
            },
            {
              "key": "open_date",
              "value": "2026-09-11",
              "type": "text"
            },
            {
              "key": "banner",
              "type": "file",
              "src": "",
              "description": "Pilih file banner/gambar (PNG/JPG maks 5MB)"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/admin/pameran/add",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "pameran", "add"]
        },
        "description": "Endpoint tambah pameran oleh Admin. Memerlukan kategori_kode, banner file, title, description, prepare_start, prepare_end, open_date."
      }
    },
    {
      "name": "3. Kunjungan - Catat Kunjungan Play (Public)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_pameran\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/kunjungan",
          "host": ["{{base_url}}"],
          "path": ["api", "kunjungan"]
        },
        "description": "Dipanggil saat user mengklik tombol Play pameran. Endpoint ini public dan tidak memerlukan autentikasi."
      }
    },
    {
      "name": "4. Statistik - Latest / Per Jam (1 Hari)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/kunjungan/statistik?start_date=2026-08-26&end_date=2026-08-26",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "kunjungan", "statistik"],
          "query": [
            {
              "key": "start_date",
              "value": "2026-08-26",
              "description": "Format: YYYY-MM-DD (Sesuaikan dengan tanggal pengujian Anda)"
            },
            {
              "key": "end_date",
              "value": "2026-08-26",
              "description": "Format: YYYY-MM-DD"
            }
          ]
        },
        "description": "Mengambil statistik rentang <= 1 hari. Data dikelompokkan otomatis per jam (00:00 - 23:00)."
      }
    },
    {
      "name": "5. Statistik - Last 7 Days (Harian)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/kunjungan/statistik?start_date=2026-08-20&end_date=2026-08-26",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "kunjungan", "statistik"],
          "query": [
            {
              "key": "start_date",
              "value": "2026-08-20"
            },
            {
              "key": "end_date",
              "value": "2026-08-26"
            }
          ]
        },
        "description": "Mengambil statistik rentang <= 31 hari. Data dikelompokkan otomatis per hari (dd MMM)."
      }
    },
    {
      "name": "6. Statistik - Last 3 Months (Mingguan)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/kunjungan/statistik?start_date=2026-05-26&end_date=2026-08-26",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "kunjungan", "statistik"],
          "query": [
            {
              "key": "start_date",
              "value": "2026-05-26"
            },
            {
              "key": "end_date",
              "value": "2026-08-26"
            }
          ]
        },
        "description": "Mengambil statistik rentang <= 90 hari. Data dikelompokkan otomatis per minggu."
      }
    },
    {
      "name": "7. Statistik - Last 1 Year (Bulanan)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/kunjungan/statistik?start_date=2025-08-26&end_date=2026-08-26",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "kunjungan", "statistik"],
          "query": [
            {
              "key": "start_date",
              "value": "2025-08-26"
            },
            {
              "key": "end_date",
              "value": "2026-08-26"
            }
          ]
        },
        "description": "Mengambil statistik rentang > 90 hari. Data dikelompokkan otomatis per bulan (MMM YYYY)."
      }
    }
  ]
}
